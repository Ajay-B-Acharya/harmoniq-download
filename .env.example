# Harmoniq Website Environment Variables
# Copy this file to .env and fill in the values when ready.

# The direct URL to the signed APK file for download.
# When this is set, the download button becomes active.
VITE_APK_DOWNLOAD_URL=

# Optional: override the public privacy policy URL.
VITE_PRIVACY_POLICY_URL=

# Optional: override the contact email address.
VITE_CONTACT_EMAIL=
